{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:email-safety": "esbuild src/lib/email-safety.test.ts --bundle --platform=node --format=esm --outfile=/tmp/email-safety.test.mjs && node --test /tmp/email-safety.test.mjs",
    "test:sin-japan-notifications": "esbuild src/lib/sin-japan-notification-format.test.ts --bundle --platform=node --format=esm --outfile=/tmp/sin-japan-notification-format.test.mjs && node --test /tmp/sin-japan-notification-format.test.mjs",
    "test:x-research-error": "esbuild src/lib/x-research-error.test.ts --bundle --platform=node --format=esm --outfile=/tmp/x-research-error.test.mjs && node --test /tmp/x-research-error.test.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.0.11",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "axios": "^1.14.0",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "http-proxy-middleware": "^3.0.5",
    "iconv-lite": "^0.7.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "openai": "^6.33.0",
    "pino": "^9",
    "pino-http": "^10",
    "playwright": "^1.59.1",
    "twilio": "^6.0.2",
    "twitter-api-v2": "^1.29.0",
    "uuid": "^13.0.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/twilio": "^3.19.3",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0"
  }
}
